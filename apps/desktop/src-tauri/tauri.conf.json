{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CONIK School Management",
  "version": "0.1.0",
  "identifier": "com.conik.schoolmanagement",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../web/out"
  },
  "app": {
    "windows": [
      {
        "title": "CONIK School Management",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
